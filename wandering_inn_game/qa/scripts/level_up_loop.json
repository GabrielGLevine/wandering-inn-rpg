{
 "_comment": "M-FP/ONBOARDING O5: warrior leveling loop. The classless start makes the old boot-warrior assumption dead, so this now LOADS the shared post_tutorial fixture (warrior L1, rusty_sword equipped, met_relc, floodplains 7,6) via the title 'Continue' -- the honest post-spar state -- then does the leveling loop proper: fight1 goblin_encounter_2 (banks the melee/sword counters) -> sleep -> Warrior L2 (skill_unlocked counter_strike) -> fight2 chieftains_raid with the L2 kit, winning AND firing the counter_strike riposte (reaction_triggered). post_tutorial is this script's outcome-defining consumer: its rng_state is tuned here so fight2 wins outright and the riposte fires (combat_move_input, the only other consumer, is rng-agnostic after its O5 re-route). Fixture load overrides --seed, so the CLI seed is cosmetic; determinism flows from the fixture rng_state.",
 "fixture_save": "post_tutorial",
 "starts_at_title": true,
 "steps": [
  { "action": "wait_for_event", "type": "ui_title_gate_rendered", "timeout_sec": 5 },
  { "action": "press", "name": "confirm" },
  { "action": "wait_for_event", "type": "ui_title_rendered", "timeout_sec": 5 },
  { "action": "move", "direction": "down", "steps": 1 },
  { "action": "press", "name": "confirm" },
  { "action": "wait_for_event", "type": "game_loaded", "timeout_sec": 5 },
  { "action": "wait_for_event", "type": "world_ready", "timeout_sec": 5 },
  { "action": "assert_state", "path": "current_map", "equals": "floodplains" },
  { "action": "assert_state", "path": "classes.warrior", "equals": 1 },
  { "action": "assert_state", "path": "player_cell", "equals": [7, 6] },

  { "_comment": "== FIGHT 1: goblin_encounter_2 (28,18) via goblin_parley draw-steel ==. (7,6) right21->(28,6), down11->(28,17).", "action": "move", "direction": "right", "steps": 21 },
  { "action": "move", "direction": "down", "steps": 11 },
  { "action": "assert_state", "path": "player_cell", "equals": [28, 17] },
  { "action": "press", "name": "interact" },
  { "action": "wait_for_event", "type": "dialogue_started", "payload_contains": { "conversation": "goblin_parley" }, "timeout_sec": 5 },
  { "action": "wait_for_event", "type": "ui_dialogue_shown", "timeout_sec": 5 },
  { "action": "press", "name": "confirm" },
  { "action": "wait_for_event", "type": "combat_started", "timeout_sec": 5 },
  { "action": "wait_for_event", "type": "ui_combat_shown", "timeout_sec": 5 },
  { "action": "wait_for_event", "type": "turn_started", "payload_contains": { "id": "pc" }, "timeout_sec": 10 },
  { "action": "wait_frames", "frames": 5 },
  { "action": "assert_state", "path": "combat.active", "equals": "pc" },
  { "action": "assert_state", "path": "combat.combatants.pc.ap", "equals": 4 },
  { "action": "assert_event_logged", "type": "ui_hotbar_rendered", "payload_contains": { "slots": 4 } },
  { "action": "combat_autoplay", "max_turns": 300 },
  { "action": "wait_for_event", "type": "combat_finished", "payload_contains": { "victory": true }, "timeout_sec": 10 },
  { "action": "press", "name": "confirm" },
  { "action": "wait_for_event", "type": "ui_combat_hidden", "timeout_sec": 5 },
  { "action": "wait_frames", "frames": 5 },

  { "_comment": "== return to inn, sleep -> Warrior L2 ==. (28,17) up11->(28,6), left21->(7,6), up+interact -> inn (14,3), left12->(2,3), down3->(2,6), down blocks on the bed, interact -> sleep.", "action": "move", "direction": "up", "steps": 11 },
  { "action": "move", "direction": "left", "steps": 21 },
  { "action": "assert_state", "path": "player_cell", "equals": [7, 6] },
  { "action": "move", "direction": "up", "steps": 1 },
  { "action": "press", "name": "interact" },
  { "action": "wait_for_event", "type": "map_changed", "payload_contains": { "map": "inn" }, "timeout_sec": 5 },
  { "action": "move", "direction": "left", "steps": 12 },
  { "action": "move", "direction": "down", "steps": 3 },
  { "action": "move", "direction": "down", "steps": 1 },
  { "action": "press", "name": "interact" },
  { "action": "wait_for_event", "type": "skill_unlocked", "payload_contains": { "skill": "counter_strike" }, "timeout_sec": 5 },
  { "action": "wait_for_event", "type": "ui_toast_rendered", "timeout_sec": 5 },
  { "action": "screenshot", "name": "01_level_up_toast" },
  { "action": "assert_state", "path": "classes.warrior", "equals": 2 },

  { "_comment": "== FIGHT 2: chieftains_raid (31,7) with the L2 kit ==. (2,6) up3->(2,3), right12->(14,3), right1->(15,3) inn_door -> floodplains (7,6), right23->(30,6), down1->(30,7), right1 blocks on the chieftains cell (31,7) & faces it, interact.", "action": "move", "direction": "up", "steps": 3 },
  { "action": "move", "direction": "right", "steps": 12 },
  { "action": "move", "direction": "right", "steps": 1 },
  { "action": "press", "name": "interact" },
  { "action": "wait_for_event", "type": "map_changed", "payload_contains": { "map": "floodplains" }, "timeout_sec": 5 },
  { "action": "move", "direction": "right", "steps": 23 },
  { "action": "move", "direction": "down", "steps": 1 },
  { "action": "move", "direction": "right", "steps": 1 },
  { "action": "assert_state", "path": "player_cell", "equals": [30, 7] },
  { "action": "press", "name": "interact" },
  { "action": "wait_for_event", "type": "combat_started", "timeout_sec": 5 },
  { "action": "wait_for_event", "type": "ui_combat_shown", "timeout_sec": 5 },
  { "action": "screenshot", "name": "02_second_fight" },
  { "action": "wait_for_event", "type": "turn_started", "payload_contains": { "id": "pc" }, "timeout_sec": 10 },
  { "action": "wait_frames", "frames": 5 },
  { "action": "assert_state", "path": "combat.active", "equals": "pc" },
  { "action": "assert_state", "path": "combat.combatants.pc.ap", "equals": 4 },
  { "action": "assert_event_logged", "type": "ui_hotbar_rendered", "payload_contains": { "slots": 4 } },
  { "action": "combat_autoplay", "max_turns": 300 },
  { "action": "wait_for_event", "type": "combat_finished", "payload_contains": { "victory": true }, "timeout_sec": 10 },
  { "action": "assert_event_logged", "type": "reaction_triggered", "payload_contains": { "skill": "counter_strike" } },
  { "action": "press", "name": "confirm" },
  { "action": "wait_for_event", "type": "ui_combat_hidden", "timeout_sec": 5 },
  { "action": "assert_event_logged", "type": "entity_removed", "payload_contains": { "id": "chieftains_raid" } },
  { "action": "screenshot", "name": "03_loop_complete" }
 ]
}
