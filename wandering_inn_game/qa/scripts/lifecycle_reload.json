{
  "_comment": "Browser lifecycle stage; lifecycle_reload.mjs owns same-context page.reload and durable IDB proof. Fixture setup occurs only in save stage. Browser touch is emulated device evidence, not physical suspension.",
  "starts_at_title": true,
  "fail_fast": true,
  "steps": [
    {
      "action": "touch_screen",
      "pos": [
        640,
        360
      ]
    },
    {
      "action": "wait_for_event",
      "type": "ui_title_rendered",
      "timeout_sec": 10,
      "payload_contains": {
        "continue_enabled": true
      }
    },
    {
      "action": "screenshot",
      "name": "00_continue"
    },
    {
      "action": "touch_title_row",
      "row": 2
    },
    {
      "action": "wait_for_event",
      "type": "game_loaded",
      "timeout_sec": 10
    },
    {
      "action": "wait_for_event",
      "type": "world_ready",
      "timeout_sec": 10
    },
    {
      "action": "assert_state",
      "path": "current_map",
      "equals": "floodplains"
    },
    {
      "action": "assert_state",
      "path": "player_cell",
      "equals": [
        8,
        6
      ]
    },
    {
      "action": "touch_cell",
      "cell": [
        9,
        6
      ]
    },
    {
      "action": "wait_for_event",
      "type": "player_moved",
      "timeout_sec": 10
    },
    {
      "action": "assert_state",
      "path": "player_cell",
      "equals": [
        9,
        6
      ]
    },
    {
      "action": "screenshot",
      "name": "02_touch_movement"
    }
  ]
}
