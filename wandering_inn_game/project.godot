; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wandering Inn RPG"
run/main_scene="res://src/world/main.tscn"
config/features=PackedStringArray("4.7")

[audio]

; THE WEB-SILENCE FIX (2026-07-13): buses created at runtime via
; AudioServer.add_bus are INVISIBLE to the web sample-playback path
; (isolated by A/B: vanilla 4.7 single-thread export, runtime bus =
; zero output, layout bus = audible). Every game sound routes through
; these buses, so every web build ever shipped was silent while native
; was fine. The layout creates them at AudioServer init on every
; platform; WIAudio._setup_buses stays as the idempotent fallback.
buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

ObservableBus="*res://src/core/observable_bus.gd"
Game="*res://src/core/game.gd"
TestDriver="*res://qa/test_driver.gd"
WIAudio="*res://src/audio/wi_audio.gd"
WIInputHints="*res://src/ui/input_hints.gd"
WISettings="*res://src/ui/wi_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

