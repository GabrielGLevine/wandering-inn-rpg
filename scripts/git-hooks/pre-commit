#!/bin/bash
# Tracked pre-commit hook (2026-07-28, user directive: catch the fast
# engine-free CI gates at commit time instead of at the PR).
# Path-scoped: a commit that touches none of the guarded surfaces runs
# nothing. Every check here is <0.5s except the leak scan (~4s), which
# only runs when the commit ADDS files (the leak vector on a public
# repo). Bypass for emergencies: WI_SKIP_HOOKS=1 git commit ... (or
# --no-verify); CI still enforces everything blocking.
# Activate via scripts/install_git_hooks.sh (worktree-scoped config).
# bash 3.2 / macOS: no mapfile, no timeout(1).

set -u

[ "${WI_SKIP_HOOKS:-0}" = "1" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"

# --- Staleness self-check (retrospective tooling 2026-08-09): worktree
# checkouts keep their own copy of this hook; after a hook edit on main, a
# stale copy blocked a commit and caused a merged-wrong-tip repair. Warn
# loudly when this file differs from main's version (never block on it --
# the diff might BE the change being committed).
if command -v git >/dev/null 2>&1; then
	_main_hook=$(git -C "$ROOT" show main:scripts/git-hooks/pre-commit 2>/dev/null || true)
	if [ -n "$_main_hook" ] && ! printf '%s' "$_main_hook" | diff -q - "$ROOT/scripts/git-hooks/pre-commit" >/dev/null 2>&1; then
		echo "pre-commit NOTE: this hook differs from main's copy -- if you are in a worktree, merge main before trusting gate results." >&2
	fi
fi
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$STAGED" ] && exit 0

fail=0
say() { printf '%s\n' "$*"; }

touches() { printf '%s\n' "$STAGED" | grep -Eq "$1"; }

# --- Leak scan: only when the commit adds new paths (the leak vector).
if git diff --cached --name-only --diff-filter=A | grep -q .; then
	if ! bash "$ROOT/scripts/leak_check.sh" >/dev/null 2>&1; then
		say "pre-commit BLOCK: scripts/leak_check.sh failed (licensed asset or secret staged?)"
		bash "$ROOT/scripts/leak_check.sh" 2>&1 | tail -20
		fail=1
	fi
fi

# --- Structural data lint + comment census: any shipped-data edit.
if touches '^wandering_inn_game/data/'; then
	if ! python3 "$ROOT/wandering_inn_game/scripts/data_lint.py" >/dev/null 2>&1; then
		say "pre-commit BLOCK: data_lint failed:"
		python3 "$ROOT/wandering_inn_game/scripts/data_lint.py" 2>&1 | tail -20
		fail=1
	fi
	# Comment census gate REMOVED (user ruling 2026-08-09): the ceiling tax
	# forced mechanical trims that twice mangled load-bearing docs; token
	# savings did not justify the encumbrance. comment_census.py remains as
	# an informational tool (run it by hand if bloat is suspected).
fi

# --- Skill-mirror sync: canonical .agents/skills vs .claude mirror.
if touches '^\.agents/skills/|^\.claude/skills/'; then
	if ! python3 "$ROOT/scripts/sync_agent_guidance.py" >/dev/null 2>&1; then
		say "pre-commit BLOCK: skill mirrors drifted — run: python3 scripts/sync_agent_guidance.py --write"
		fail=1
	fi
fi

# --- Advisory (never blocks; mirrors the CI docs-drift demotion).
if touches '^wandering_inn_game/qa/manifest\.json$|^wandering_inn_game/qa/scripts/'; then
	if ! python3 "$ROOT/scripts/render_qa_notes.py" >/dev/null 2>&1; then
		say "pre-commit note: QA notes drifted — run: python3 scripts/render_qa_notes.py --write (advisory)"
	fi
fi
if touches '^docs/|^README\.md$'; then
	if ! python3 "$ROOT/scripts/check_doc_drift.py" >/dev/null 2>&1; then
		say "pre-commit note: doc-drift check reports issues (advisory):"
		python3 "$ROOT/scripts/check_doc_drift.py" 2>&1 | tail -8
	fi
fi

exit $fail
